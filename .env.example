# Copy to .env and populate credentials as needed.
# Empty integration variables run in local dry-run / skipped mode so components can be enabled incrementally.

# ---------- Core ----------
IL_DATABASE_URL=sqlite:///./incidentlens.db
IL_PUBLIC_URL=http://localhost:8000          # reachable IncidentLens base URL for evidence links
IL_WEBHOOK_TOKEN=                             # protects API endpoints via "Authorization: Bearer <token>"

# ---------- Paging and notifications ----------
IL_PAGERDUTY_ROUTING_KEY=
# Option 1 (recommended, supports interactive buttons): Slack App bot token
IL_SLACK_BOT_TOKEN=
IL_SLACK_CHANNEL=
IL_SLACK_SIGNING_SECRET=                      # required for interactive buttons (/slack/interactions)
# Option 2 (message-only): Incoming Webhook
IL_SLACK_WEBHOOK_URL=

# ---------- Read-only evidence sources ----------
IL_PROMETHEUS_URL=
IL_PROMETHEUS_BEARER_TOKEN=
IL_LOKI_URL=
IL_GRAFANA_URL=                               # optional: open log evidence links in Grafana Explore
IL_GRAFANA_LOKI_DATASOURCE=Loki
IL_GITHUB_TOKEN=                              # read recent GitHub deployments
IL_INVESTIGATION_TIMEOUT_SECONDS=240

# ---------- Optional LLM refinement ----------
# none: deterministic rules only. anthropic: Claude Messages API. openai-compatible: any /chat/completions server.
IL_LLM_PROVIDER=none
IL_LLM_API_KEY=
IL_LLM_MODEL=                                 # required when LLM is enabled
IL_LLM_BASE_URL=                              # required for openai-compatible, e.g. http://vllm.internal:8000/v1

# ---------- One-click actions ----------
IL_ACTIONS_ENABLED=false                      # false = preview command only without executing

# ---------- Digests and schedules ----------
IL_DIGEST_DIR=digests
IL_DIGEST_GIT_PUSH=false                      # true = auto-commit and push (digest dir must be a Git repo)
IL_DIGEST_INTERVAL_MINUTES=240
IL_DIGEST_INVESTIGATION_LIMIT=5               # max ongoing 🟡 groups investigated per digest
IL_ESCALATION_CHECK_SECONDS=60
IL_RETENTION_DAYS=180
IL_CHANGE_LOOKBACK_HOURS=12
