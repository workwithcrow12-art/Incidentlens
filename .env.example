# Copy to .env and populate credentials as needed.
# Empty integration variables run in local dry-run / skipped mode so components can be enabled incrementally.
# Keep comments on their own lines (never inline after KEY=) for Docker Compose and --env-file compatibility.

# ---------- Core ----------
IL_DATABASE_URL=sqlite:///./incidentlens.db
# Reachable IncidentLens base URL used in generated evidence links:
IL_PUBLIC_URL=http://localhost:8000
# REQUIRED: protects API endpoints via "Authorization: Bearer <token>"
IL_WEBHOOK_TOKEN=
# Local-only opt-out (true = allow unauthenticated requests when IL_WEBHOOK_TOKEN is unset):
IL_ALLOW_UNAUTHENTICATED=false

# ---------- Paging and notifications ----------
IL_PAGERDUTY_ROUTING_KEY=
# Option 1 (recommended, supports interactive buttons): Slack App bot token + channel + signing secret
IL_SLACK_BOT_TOKEN=
IL_SLACK_CHANNEL=
IL_SLACK_SIGNING_SECRET=
# Option 2 (message-only): Slack Incoming Webhook
IL_SLACK_WEBHOOK_URL=

# ---------- Read-only evidence sources ----------
IL_PROMETHEUS_URL=
IL_PROMETHEUS_BEARER_TOKEN=
IL_LOKI_URL=
# Optional: open log evidence links in Grafana Explore
IL_GRAFANA_URL=
IL_GRAFANA_LOKI_DATASOURCE=Loki
# Optional: GitHub token with read access to repository deployments
IL_GITHUB_TOKEN=
IL_INVESTIGATION_TIMEOUT_SECONDS=240

# ---------- Optional LLM refinement ----------
# Provider: none (deterministic rules only), anthropic (Claude Messages API), or openai-compatible (/chat/completions)
IL_LLM_PROVIDER=none
IL_LLM_API_KEY=
# Required when IL_LLM_PROVIDER is not "none":
IL_LLM_MODEL=
# Required for openai-compatible, e.g. http://vllm.internal:8000/v1
IL_LLM_BASE_URL=

# ---------- One-click actions ----------
# false = preview command only without executing
IL_ACTIONS_ENABLED=false

# ---------- Digests and schedules ----------
IL_DIGEST_DIR=digests
# true = auto-commit and push (digest dir must be a Git repo)
IL_DIGEST_GIT_PUSH=false
IL_DIGEST_INTERVAL_MINUTES=240
# Max ongoing action alert groups investigated per digest:
IL_DIGEST_INVESTIGATION_LIMIT=5
IL_ESCALATION_CHECK_SECONDS=60
IL_RETENTION_DAYS=180
IL_CHANGE_LOOKBACK_HOURS=12
