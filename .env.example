# Sao chép thành .env rồi điền giá trị thật.
# Biến nào để trống thì phần đó chạy ở chế độ dry-run (chỉ ghi log), nên có thể bật dần từng phần.

# ---------- Cơ bản ----------
IL_DATABASE_URL=sqlite:///./incidentlens.db
IL_PUBLIC_URL=http://localhost:8000          # địa chỉ của IncidentLens, dùng cho link trong bằng chứng
IL_WEBHOOK_TOKEN=                             # bảo vệ mọi API: "Authorization: Bearer <token>"

# ---------- Gọi on-call và thông báo ----------
IL_PAGERDUTY_ROUTING_KEY=
# Cách 1 (khuyên dùng, có nút bấm): Slack App với bot token
IL_SLACK_BOT_TOKEN=
IL_SLACK_CHANNEL=
IL_SLACK_SIGNING_SECRET=                      # bắt buộc để nút bấm hoạt động (/slack/interactions)
# Cách 2 (đơn giản, chỉ tin nhắn): Incoming Webhook
IL_SLACK_WEBHOOK_URL=

# ---------- Nguồn bằng chứng cho điều tra (chỉ cần quyền ĐỌC) ----------
IL_PROMETHEUS_URL=
IL_PROMETHEUS_BEARER_TOKEN=
IL_LOKI_URL=
IL_GRAFANA_URL=                               # nếu có: link log mở trong Grafana Explore
IL_GRAFANA_LOKI_DATASOURCE=Loki
IL_GITHUB_TOKEN=                              # đọc deploy gần đây
IL_INVESTIGATION_TIMEOUT_SECONDS=240

# ---------- LLM (tùy chọn) ----------
# none: điều tra bằng luật. anthropic: Claude API. openai-compatible: mọi máy chủ /chat/completions (kể cả tự host).
IL_LLM_PROVIDER=none
IL_LLM_API_KEY=
IL_LLM_MODEL=                                 # bắt buộc khi bật LLM; xem tên model tại https://docs.claude.com
IL_LLM_BASE_URL=                              # cho openai-compatible, ví dụ http://vllm.internal:8000/v1

# ---------- Hành động một chạm ----------
IL_ACTIONS_ENABLED=false                      # false = chỉ hiển thị lệnh SẼ chạy, không chạy thật

# ---------- Digest và lịch chạy ----------
IL_DIGEST_DIR=digests
IL_DIGEST_GIT_PUSH=false                      # true = tự commit + push (thư mục digest phải là Git repo)
IL_DIGEST_INTERVAL_MINUTES=240
IL_DIGEST_INVESTIGATION_LIMIT=5               # số mục 🟡 tối đa được điều tra mỗi digest
IL_ESCALATION_CHECK_SECONDS=60
IL_RETENTION_DAYS=180
IL_CHANGE_LOOKBACK_HOURS=12
